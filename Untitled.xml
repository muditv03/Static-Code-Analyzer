    <description>Update For  : 1334469, 1433751, 370708, WebTeam # 370741
Changes for UK Billing Start Date</description>
    <environments>Default</environments>
    <formulas>
        <name>AgreementSignedDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.echosign_dev1__DateSigned__c})</expression>
    </formulas>
    <formulas>
        <name>BillingStartdate</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        ISPICKVAL({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.CPQ_Composite__c}, &quot;United Kingdom&quot;),
        ({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__StartDate__c} &lt; {!$Record.echosign_dev1__DateSignedDate__c}) || ({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__StartDate__c} &gt; {!$Record.echosign_dev1__DateSignedDate__c} &amp;&amp; ISPICKVAL({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Free_Time__c}, &quot;Yes&quot;) &amp;&amp; {!$Record.echosign_dev1__DateSignedDate__c} &gt; {!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Start_Free_Time__c})
    ),
    IF(
        ISPICKVAL({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Free_Time__c}, &quot;Yes&quot;),
        ({!$Record.echosign_dev1__DateSignedDate__c} + 1) + {!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Free_Time_No_of_Days__c},
        ({!$Record.echosign_dev1__DateSignedDate__c} + 1)
    ),
    {!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__StartDate__c}
)</expression>
    </formulas>
    <formulas>
        <name>declinedAgreementStatus</name>
        <dataType>String</dataType>
        <expression>IF(
  TEXT($Record.SBES__Quote_Document__r.SBQQ__Quote__r.CPQ_Composite__c) = &apos;United Kingdom&apos;,
  &apos;Rejected&apos;,
  &apos;Approved&apos;
)</expression>
    </formulas>
    <formulas>
        <name>invoiceFrequency</name>
        <dataType>String</dataType>
        <expression>IF( TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__BillingFrequency__c}) != null  &amp;&amp; TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__BillingFrequency__c})  != TEXT({!$Record.echosign_dev1__Opportunity__r.Invoice_Frequency__c}),TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__BillingFrequency__c}) , TEXT({!$Record.echosign_dev1__Opportunity__r.Invoice_Frequency__c}) )</expression>
    </formulas>
    <formulas>
        <name>ManualProcessing</name>
        <dataType>Boolean</dataType>
        <expression>IF(
    AND(
        ISPICKVAL({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.CPQ_Composite__c}, &quot;United Kingdom&quot;),
        ({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__StartDate__c} &lt; {!AgreementSignedDate}) || 
          ({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.SBQQ__StartDate__c} &gt; {!AgreementSignedDate} &amp;&amp; 
          ISPICKVAL({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Free_Time__c}, &quot;Yes&quot;) &amp;&amp; 
          {!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Start_Free_Time__c}  &lt; {!AgreementSignedDate})
    ),
    True,
    {!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.On_Hold__c}
)</expression>
    </formulas>
    <formulas>
        <name>programName</name>
        <dataType>String</dataType>
        <expression>IF( TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Bridge_Program__c}) = null, &quot;Not Applicable&quot; , TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Bridge_Program__c}) )</expression>
    </formulas>
    <formulas>
        <name>promoName</name>
        <dataType>String</dataType>
        <expression>IF( TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Promo_Name__c}) = null, &quot;Not Applicable&quot; , TEXT({!$Record.SBES__Quote_Document__r.SBQQ__Quote__r.Promo_Name__c}) )</expression>
    </formulas>
