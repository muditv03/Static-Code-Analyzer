<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>This is to assign lob for opportunity based on the opportunity account primary country.</description>
        <name>Assign_LOB_for_Opportunity</name>
        <label>Assign LOB for Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Line_of_Business__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varCustomMetaLOBRecord.LOB__c</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>If there is no LOB available with country matching then assign it to default BIS Channels.</description>
        <name>Assign_LOB_for_Opportunity_to_BIS_Channels</name>
        <label>Assign LOB for Opportunity to BIS Channels</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Line_of_Business__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>BIS Channels</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <customErrors>
        <description>Unable to retrieve the line of business from country vs lob custom metadata.</description>
        <name>Unable_to_get_Line_Of_Business</name>
        <label>Unable to get Line Of Business</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <customErrorMessages>
            <errorMessage>Something went wrong, while trying to get the line of business for the opportunity based on opportunity account primary country.  Please contact system administrator.</errorMessage>
            <fieldSelection>Line_of_Business__c</fieldSelection>
            <isFieldError>true</isFieldError>
        </customErrorMessages>
    </customErrors>
    <decisions>
        <name>BIS_Check</name>
        <label>BIS Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>BIS</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Business_Unit__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BIS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Country_vs_LOB_Custom_Metadata</targetReference>
            </connector>
            <label>BIS</label>
        </rules>
    </decisions>
    <decisions>
        <description>This is to check whether country lob is available.</description>
        <name>Country_LOB_Available</name>
        <label>Country LOB Available</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_LOB_for_Opportunity_to_BIS_Channels</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varCustomMetaLOBRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_LOB_for_Opportunity</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Created as part of 2355281.</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Opportunity Before Save-CPQ {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity Before Save-CPQ</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>This is to query country vs LOB custom metadata</description>
        <name>Get_Country_vs_LOB_Custom_Metadata</name>
        <label>Get Country vs LOB Custom Metadata</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Country_LOB_Available</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Unable_to_get_Line_Of_Business</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Label</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account.BillingCountry</elementReference>
            </value>
        </filters>
        <object>gNS_Country_Vs_LOB__mdt</object>
        <outputReference>varCustomMetaLOBRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>LOB__c</queriedFields>
        <queriedFields>Label</queriedFields>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>BIS_Check</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCustomMetaLOBRecord</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>gNS_Country_Vs_LOB__mdt</objectType>
    </variables>
</Flow>
