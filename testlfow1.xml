    <formulas>
        <name>AssignRecordType</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Type} ,&quot;Ship To&quot;), &quot;Site_Account_NA_Air&quot;, &quot;CTS_Bill_To_Account&quot;)</expression>
    </formulas>
    <formulas>
        <name>IsCreate</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>sfsAccountStatusSetXxont1222</name>
        <dataType>String</dataType>
        <expression>IF({!$Permission.SFS_CPI_User} == true , IF(OR(ISPICKVAL({!$Record.Status__c }, &quot;A&quot;),ISPICKVAL({!$Record.Status__c }, &quot;Active&quot;)), &quot;Active&quot;, &quot;Inactive&quot;), TEXT({!$Record.Status__c}))</expression>
    </formulas>
    <formulas>
        <name>varCounty</name>
        <dataType>String</dataType>
        <expression>{!$Record.County__c}</expression>
    </formulas>
    <formulas>
        <name>varShippingAddress</name>
        <dataType>String</dataType>
        <expression>{!$Record.CTS_Global_Shipping_Address_1__c} + &quot; &quot; + {!$Record.CTS_Global_Shipping_Address_2__c}</expression>
    </formulas>
    <formulas>
        <name>varShippingStreet</name>
        <dataType>String</dataType>
        <expression>{!$Record.CTS_Global_Shipping_Address_1__c} + &apos; &apos; + {!$Record.CTS_Global_Shipping_Address_2__c}</expression>
    </formulas>
